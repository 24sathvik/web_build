# Deployment & Base URL
SITE_URL=https://zyxen.in
NEXT_PUBLIC_SITE_URL=https://zyxen.in

# Master Indexing Switch (Set "true" only on production after domain & DNS cutover)
# Blocked ("noindex, nofollow" & disallow: ["/"]) by default when unset or false.
ALLOW_INDEXING=false

# EmailJS Service Configuration (Client-side contact form)
# Obtain these from your EmailJS account dashboard: https://dashboard.emailjs.com
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Search Engine & Analytics Telemetry
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
BING_VERIFICATION=

# TinaCMS Cloud Credentials (from https://app.tina.io)
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Deployment Git Branch (defaults to VERCEL_GIT_COMMIT_REF or master)
GITHUB_BRANCH=master
